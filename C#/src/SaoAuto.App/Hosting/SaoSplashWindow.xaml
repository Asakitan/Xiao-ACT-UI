<Window x:Class="SaoAuto.App.Hosting.SaoSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SaoAuto · Boot"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#FF02040A"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <!-- Bug fix (user 2026-06-01, fifth pass): SAOLinkStart now renders via
         WebView2 + web/linkstart.html — a 1:1 WebGL2 port of the Python
         sao_theme.SAOLinkStart moderngl tunnel (same GLSL shaders, same
         _animate phase dispatch, _calc_bg ramp, _gen_tunnel particle model,
         cubic-bezier camera, _build_vp_matrix projection). This replaces the
         OpenTK/GLWpfControl path which black-screened / crashed on some GPUs
         and was only an approximation. Because linkstart.html is plain
         WebGL, it is identical across every UI mode and can be previewed
         standalone in any browser to verify fidelity without launching the
         app. The page posts 'linkstart_done' via window.chrome.webview when
         the 9-second sequence completes; the code-behind closes on that
         message (with a 10.5s safety timeout backstop). -->
    <Grid Background="#FF02040A">
        <wv2:WebView2 x:Name="SplashWeb" DefaultBackgroundColor="#02040A" />
    </Grid>
</Window>
