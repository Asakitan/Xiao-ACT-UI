#pragma once

#include <array>
#include <cstddef>
#include <cstdint>

namespace sao::runtime {

using std::uint8_t;

namespace detail {

inline const volatile uint8_t kBundleKeyShareOne[32]{
    @SAO_RUNTIME_KEY_SHARE_ONE@
};
inline const volatile uint8_t kBundleKeyShareTwo[32]{
    @SAO_RUNTIME_KEY_SHARE_TWO@
};

}

[[nodiscard]] __declspec(noinline) inline std::array<uint8_t, 32> bundle_key() noexcept {
    std::array<uint8_t, 32> key{};
    for (std::size_t index = 0; index < key.size(); ++index) {
        key[index] = static_cast<uint8_t>(
            detail::kBundleKeyShareOne[index] ^
            detail::kBundleKeyShareTwo[index]);
    }
    return key;
}

