{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "sao-autoc",
  "version": "0.2.0",
  "description": "SAO Auto — fully independent native C++ platform.",
  "homepage": "https://github.com/asakitan/sao-auto",
  "builtin-baseline": "f87344cac03158cbf1467264565f1fd36b382a24",
  "dependencies": [
    { "name": "nlohmann-json",  "version>=": "3.11.3" },
    { "name": "spdlog",         "version>=": "1.13.0" },
    { "name": "fmt",            "version>=": "10.2.1" },
    { "name": "openssl",        "version>=": "3.2.0" },
    { "name": "mbedtls",        "version>=": "3.5.0" },
    { "name": "zstd",           "version>=": "1.5.5" },
    { "name": "zlib",           "version>=": "1.3.0" },
    { "name": "libzip",         "version>=": "1.10.1" },
    { "name": "protobuf",       "version>=": "3.21.12" },
    { "name": "boost-asio",     "version>=": "1.83.0" },
    { "name": "boost-beast",    "version>=": "1.83.0" },
    { "name": "cpp-httplib",    "version>=": "0.14.3" },
    { "name": "glfw3",          "version>=": "3.3.9" },
    { "name": "glad",           "version>=": "0.1.36" },
    { "name": "directx-headers","version>=": "1.611.0" },
    { "name": "lua",            "version>=": "5.4.6" },
    { "name": "angelscript",    "version>=": "2.36.1" },
    { "name": "python3",        "version>=": "3.11.8" },
    { "name": "imgui",          "version>=": "1.90.0" },
    { "name": "blake3",         "version>=": "1.5.0" },
    { "name": "re2",            "version>=": "20240102" },
    { "name": "sqlite3",        "version>=": "3.44.2" },
    { "name": "cli11",          "version>=": "2.4.1" },
    { "name": "tomlplusplus",   "version>=": "3.4.0" },
    { "name": "concurrentqueue","version>=": "1.0.4" }
  ],
  "features": {
    "with-imgui": {
      "description": "Enable ImGui-based native panels alongside the D2D widget kit.",
      "dependencies": [ "imgui" ]
    },
    "with-directshow": {
      "description": "Enable DirectShow-based screen capture in security/anti_screencap.",
      "dependencies": []
    },
    "with-full-tools": {
      "description": "Include heavyweight dependencies used only by the CLI tools.",
      "dependencies": [
        "libzip",
        "cli11",
        "python3"
      ]
    },
    "with-python3": {
      "description": "Resolve the Python 3.11 embedded runtime via vcpkg (alternative to FetchContent).",
      "dependencies": [
        "python3"
      ]
    }
  },
  "overrides": [],
  "vcpkg-configuration": {
    "default-registry": {
      "kind": "git",
      "baseline": "f87344cac03158cbf1467264565f1fd36b382a24",
      "repository": "https://github.com/microsoft/vcpkg"
    }
  }
}
